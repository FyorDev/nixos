# Catppuccin Mocha for Krita.
#
# Krita picks its UI theme from KDE colour scheme files -- its own six live in
# share/color-schemes inside the package -- and reads user ones out of
# ~/.local/share/color-schemes. So this is the whole of "theming Krita": drop a
# scheme in beside its own and pick it in Settings > Configure Krita > General >
# Window > Theme. Stylix's Qt target handles the widget style, not this palette.
#
# Colours are Catppuccin Mocha, as RGB triples because that is the format KDE
# schemes use. base/mantle/crust for the surfaces, text/subtext for the
# foregrounds, mauve for selection to match the rest of the setup.
[General]
ColorScheme=Catppuccin Mocha
Name=Catppuccin Mocha
shadeSortColumn=true

[KDE]
contrast=4

[ColorEffects:Disabled]
Color=49,50,68
ColorAmount=0
ColorEffect=0
ContrastAmount=0.65
ContrastEffect=1
IntensityAmount=0.1
IntensityEffect=2

[ColorEffects:Inactive]
ChangeSelectionColor=true
Color=49,50,68
ColorAmount=0.025
ColorEffect=2
ContrastAmount=0.1
ContrastEffect=2
Enable=false
IntensityAmount=0
IntensityEffect=0

