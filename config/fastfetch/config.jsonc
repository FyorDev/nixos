{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
    "type": "file-raw",
    "source": "@LOGO@",
    "padding": {
      "top": 2,
      "left": 1,
      "right": 3
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "38;2;203;166;247",
      "title": "38;2;203;166;247",
      "output": "38;2;205;214;244"
    },
    "percent": {
      "type": 1
    },
    "size": {
      "maxPrefix": "GB",
      "ndigits": 2
    }
  },
  "modules": [
    "break",
    {
      "type": "custom",
      "format": "\u001b[38;2;203;166;247m ┌────────────────────────┐\u001b[0m"
    },
    {
      "type": "kernel",
      "key": " OS",
      "format": "{sysname} \u001b[38;2;250;179;135m{release}\u001b[38;2;205;214;244m"
    },
    {
      "type": "os",
      "key": " ├󱄅 ",
      "format": "{name} \u001b[38;2;250;179;135m{version}\u001b[38;2;205;214;244m {arch}"
    },
    {
      "type": "gpu",
      "key": " ├ ",
      "format": "{driver}"
    },
    {
      "type": "shell",
      "key": " └ "
    },
    {
      "type": "wm",
      "key": "└ "
    },
    {
      "type": "host",
      "key": " PC"
    },
    {
      "type": "cpu",
      "key": " ├ ",
      "format": "{name} (\u001b[38;2;250;179;135m{cores-logical}\u001b[38;2;205;214;244m) @ \u001b[38;2;250;179;135m{freq-max}\u001b[38;2;205;214;244m"
    },
    {
      "type": "gpu",
      "key": " ├󰹑 "
    },
    {
      "type": "memory",
      "key": " ├ ",
      "format": "\u001b[38;2;250;179;135m{used}\u001b[38;2;205;214;244m / \u001b[38;2;250;179;135m{total}\u001b[38;2;205;214;244m (\u001b[38;2;250;179;135m{percentage}\u001b[38;2;205;214;244m)"
    },
    {
      "type": "swap",
      "key": " ├ ",
      "format": "\u001b[38;2;250;179;135m{used}\u001b[38;2;205;214;244m / \u001b[38;2;250;179;135m{total}\u001b[38;2;205;214;244m (\u001b[38;2;250;179;135m{percentage}\u001b[38;2;205;214;244m)"
    },
    {
      "type": "disk",
      "key": " ├ ",
      "folders": "/",
      "format": "\u001b[38;2;250;179;135m{size-used}\u001b[38;2;205;214;244m / \u001b[38;2;250;179;135m{size-total}\u001b[38;2;205;214;244m (\u001b[38;2;250;179;135m{size-percentage}\u001b[38;2;205;214;244m)"
    },
    {
      "type": "uptime",
      "key": " ├ ",
      "format": "\u001b[38;2;250;179;135m{days}\u001b[38;2;205;214;244m days \u001b[38;2;250;179;135m{hours}\u001b[38;2;205;214;244m hours \u001b[38;2;250;179;135m{minutes}\u001b[38;2;205;214;244m mins"
    },
    {
      "type": "custom",
      "format": "\u001b[38;2;203;166;247m └────────────────────────┘\u001b[0m"
    }
  ]
}
